# Plantilla de variables de entorno. Copiar a `.env` y ajustar por ambiente.
#
#   cp .env.example .env
#
# El `.env` real NO se versiona (ver .gitignore): el target del proxy y el
# modo de mocking cambian entre local, test y produccion.
#
# Vite solo expone al bundle las variables con prefijo `VITE_APP_`
# (ver `envPrefix` en vite.config.ts). Todo lo que se ponga aca TERMINA
# EN EL CLIENTE: no poner secretos.

# Base de las llamadas al API. Es una ruta relativa a proposito: el mismo
# origen sirve el SPA y proxea `/api`, asi la cookie httpOnly de refresh
# (`sso_refresh`) viaja sin CORS ni SameSite=None.
VITE_APP_API_URL=/api

# `active` monta MSW y la app corre contra los mocks del navegador, sin
# backend. Cualquier otro valor la deja hablando con el gateway real.
VITE_APP_ENABLE_API_MOCKING=inactive

# URL publica del front. Se usa para armar enlaces absolutos.
VITE_APP_APP_URL=http://localhost:5173

# A donde apunta el proxy de `/api` en desarrollo (el api-gateway del SSO).
# En produccion lo resuelve el Worker de Cloudflare, no esta variable
# (ver `API_PROXY_TARGET` en wrangler.jsonc).
VITE_APP_API_PROXY_TARGET=http://localhost:8080

# Nombre de la app. Identifica el aplicativo contra el SSO.
VITE_APP_NAME=PIGSE
